# Public example only. Do not use this as a production .env.

SITE_TITLE=Issue Trace Public Prototype
BASE_URL=https://example.invalid
PUBLIC_REQUEST_DEFAULT_MODE=review_first
PUBLIC_REQUEST_HOURLY_AUTO_LIMIT=0
REQUEST_RATE_PER_IP_PER_HOUR=0
